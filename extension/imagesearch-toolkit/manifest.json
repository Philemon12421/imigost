{
  "manifest_version": 3,
  "name": "ImageSearch Toolkit",
  "version": "1.0.0",
  "description": "Right-click any image to crop it for social media or compress it. Add any page to your link page. Search photos in one click.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ImageSearch Toolkit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["contextMenus", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
