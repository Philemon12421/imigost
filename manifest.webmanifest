{
  "name": "ImageSearch",
  "short_name": "ImageSearch",
  "description": "Search free photos and build a single link page for all your social profiles.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f2f3f1",
  "theme_color": "#3a47f0",
  "categories": ["photo", "social", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Search photos", "url": "index.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Create link page", "url": "links.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Photo tools", "url": "tools.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
